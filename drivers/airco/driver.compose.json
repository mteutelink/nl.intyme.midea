{
  "name": {
    "en": "Airconditioning",
    "nl": "Airconditioning"
  },
  "class": "thermostat",
  "capabilities": [
    "onoff",
    "thermostat_mode",
    "target_temperature",
    "measure_temperature",
    "measure_temperature.inside",
    "measure_temperature.outside",
    "thermostat_boost",
    "thermostat_fan_speed",
    "thermostat_swing_mode",
    "thermostat_eco",
    "thermostat_freeze_protection"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 16,
      "max": 30,
      "step": 0.5
    },
    "measure_temperature": {
      "title": {
        "en": "Current temperature",
        "nl": "Huidige temperatuur"
      }
    },
    "measure_temperature.inside": {
      "title": {
        "en": "Inside temperature",
        "nl": "Binnentemperatuur"
      }
    },
    "measure_temperature.outside": {
      "title": {
        "en": "Outside temperature",
        "nl": "Buitentemperatuur"
      }
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "pair": [
    {
      "id": "discovery",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "token_and_key",
      "navigation": {
        "next": "login_credentials"
      }
    },
    {
      "id": "login_credentials",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "token_and_key",
      "navigation": {
        "next": "login_credentials"
      }
    },
    {
      "id": "login_credentials"
    }
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/driver-small.png",
    "large": "{{driverAssetsPath}}/images/driver-large.png",
    "xlarge": "{{driverAssetsPath}}/images/driver-xlarge.png"
  }
}
